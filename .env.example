# Dropbox Configuration
# Get your access token from https://www.dropbox.com/developers/apps
FOOTBALL_CALENDAR_DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here

# Optional: Path in Dropbox where calendar files should be uploaded (default: /)
FOOTBALL_CALENDAR_DROPBOX_UPLOAD_PATH=/football-calendars

# Optional: Enable/disable Dropbox upload (can also use --upload-dropbox CLI flag)
FOOTBALL_CALENDAR_DROPBOX_ENABLED=false
